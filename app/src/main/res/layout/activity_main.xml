
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <!-- Titulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MARCADOR DE VOLEIBOL"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Nombres de los equipos -->
        <EditText
            android:id="@+id/edtEquipo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del equipo 1"
            android:inputType="textCapWords"
            android:maxLength="30" />

        <EditText
            android:id="@+id/edtEquipo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del equipo 2"
            android:inputType="textCapWords"
            android:maxLength="30" />

        <!-- Iniciar partido -->
        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar partido" />

        <!-- Marcador del equipo 1 -->
        <TextView
            android:id="@+id/txtEquipo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Equipo 1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtPuntosEquipo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="48sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnPuntoEquipo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+1 Equipo 1" />

        <Button
            android:id="@+id/btnRestarEquipo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-1 Equipo 1" />

        <!-- Marcador del equipo 2 -->
        <TextView
            android:id="@+id/txtEquipo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Equipo 2"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtPuntosEquipo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="48sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnPuntoEquipo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+1 Equipo 2" />

        <Button
            android:id="@+id/btnRestarEquipo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-1 Equipo 2" />

        <!-- Resultado del partido -->
        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <!-- Nuevo set -->
        <Button
            android:id="@+id/btnNuevoSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nuevo set" />

    </LinearLayout>
</ScrollView>